---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_EMAIL } from '../consts';
import { projects } from '../data/projects';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site,
	email: SITE_EMAIL,
};

// Chronological, earliest to latest — this is a retrospective ("here's
// what I've made"), not a resume, so it reads as a career arc rather than
// leading with a current title. TODO: add real start/end years once
// confirmed (see year: undefined below) — a public portfolio shouldn't
// guess at someone's employment dates.
const career = [
	{
		org: 'Procter & Gamble',
		role: 'Creative Director',
		year: undefined,
		description: 'Early career foundation in global brand development and creative strategy.',
	},
	{
		org: 'Coty',
		role: 'Creative Director',
		year: undefined,
		description: 'Leadership roles contributing to global brand development and creative strategy for major beauty brands.',
	},
	{
		org: 'Wella Company',
		role: 'Global Creative Director',
		year: undefined,
		description: 'Shaping brand development, advertising, and consumer product strategy across the portfolio, drawing on deep expertise as a hair care specialist.',
	},
];

// TODO: add the other quotes from the live site here once supplied — the
// carousel controls (dots/arrows) only render once there's more than one.
const testimonials = [
	{
		quote: 'I’ve had the pleasure to work with Marcy over several years, during our time together at P&G, and then at Wella. I could not recommend Marcy enough as an outstanding expert in all aspects of Beauty Production — and in particular for Hair.',
		name: 'Javier Sandoval',
	},
];

const workPreview = projects.slice(0, 5);
---

<BaseLayout title="Home" description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-content">
				<p class="eyebrow">creative direction &middot; beauty &amp; consumer products</p>
				<h1 class="hero-title">marcy cona</h1>
				<p class="hero-sub">
					A selection of brand, advertising, and product work from two decades in beauty and
					consumer goods &mdash; including campaigns for Wella and Clairol.
				</p>
				<div class="hero-actions">
					<a href="/portfolio/" class="btn btn-primary">view work</a>
					<a href="/about/" class="btn btn-secondary">about marcy</a>
				</div>
			</div>
			<div class="hero-mark" aria-hidden="true">
				<span>mc</span>
			</div>
		</div>
	</section>

	<section class="container section work-section">
		<h2>selected work</h2>
		<p class="section-intro">
			A look at recent campaigns and brand work &mdash; visit the full <a href="/portfolio/">portfolio</a> for more.
		</p>
		<div class="masonry" id="work-masonry">
			{workPreview.map((project) => (
				<a href={`/portfolio/${project.slug}/`} class="masonry-item">
					<img src={project.heroImage.src} alt={project.heroImage.alt} loading="lazy" />
				</a>
			))}
		</div>
		<a href="/portfolio/" class="btn btn-secondary view-all">view all work</a>
	</section>

	<section class="band band-subtle">
		<div class="container section">
			<h2>career</h2>
			<p class="section-intro">Two decades shaping brand and creative direction in beauty.</p>
			<ol class="timeline">
				{career.map((item, i) => (
					<li class="timeline-item" style={`--i: ${i}`}>
						<span class="timeline-dot" aria-hidden="true"></span>
						<div class="timeline-content">
							<h3>{item.org}</h3>
							<p class="timeline-role">{item.role}{item.year && <> &middot; {item.year}</>}</p>
							<p>{item.description}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="container section testimonial-section">
		<div class="testimonial-track" id="testimonial-track">
			{testimonials.map((t) => (
				<blockquote class="testimonial">
					<p>&ldquo;{t.quote}&rdquo;</p>
					<footer>
						<cite>{t.name}</cite>
					</footer>
				</blockquote>
			))}
		</div>
		{testimonials.length > 1 && (
			<div class="testimonial-controls">
				<button type="button" class="testimonial-arrow" id="testimonial-prev" aria-label="Previous quote">&larr;</button>
				<div class="testimonial-dots" id="testimonial-dots" role="tablist" aria-label="Select quote">
					{testimonials.map((_, i) => (
						<button
							type="button"
							class="testimonial-dot"
							role="tab"
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-label={`Quote ${i + 1} of ${testimonials.length}`}
						></button>
					))}
				</div>
				<button type="button" class="testimonial-arrow" id="testimonial-next" aria-label="Next quote">&rarr;</button>
			</div>
		)}
	</section>

	<section class="band band-subtle">
		<div class="container section contact-section">
			<div class="contact-grid">
				<div class="contact-info">
					<h2>get in touch</h2>
					<p>
						Open to conversations about creative direction, brand strategy, and new
						opportunities.
					</p>
					<p class="contact-details">
						<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
					</p>
				</div>
				<div class="contact-form-wrap">
					<ContactForm />
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	import { initMasonry } from '../scripts/masonry';

	const el = document.getElementById('work-masonry');
	if (el) initMasonry(el);

	// Testimonial carousel — only wired up when there's more than one
	// slide (the dots/arrows are omitted from the markup entirely
	// otherwise, so this is a no-op for a single quote).
	const track = document.getElementById('testimonial-track') as HTMLDivElement | null;
	const dotsWrap = document.getElementById('testimonial-dots');
	const prevBtn = document.getElementById('testimonial-prev');
	const nextBtn = document.getElementById('testimonial-next');

	if (track && dotsWrap && prevBtn && nextBtn) {
		const slides = Array.from(track.children) as HTMLElement[];
		const dots = Array.from(dotsWrap.children) as HTMLButtonElement[];
		let index = 0;

		function show(i: number) {
			index = (i + slides.length) % slides.length;
			slides.forEach((slide, n) => slide.toggleAttribute('hidden', n !== index));
			dots.forEach((dot, n) => dot.setAttribute('aria-selected', n === index ? 'true' : 'false'));
		}

		dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
		prevBtn.addEventListener('click', () => show(index - 1));
		nextBtn.addEventListener('click', () => show(index + 1));
		show(0);
	}
</script>

<style>
	/* Full-width background bands — the band itself spans the viewport,
	   while a nested .container keeps the actual content at the same max
	   width as every other section instead of the background looking like
	   a floating inset card. */
	.band-subtle {
		background: var(--color-bg-subtle);
	}

	.section {
		padding-block: var(--space-2xl);
	}

	.section-intro {
		max-width: 640px;
	}

	/* Hero */
	.hero {
		border-bottom: 1px solid var(--color-border);
	}

	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2xl);
		padding-block: var(--space-3xl) var(--space-2xl);
	}

	.hero-content {
		max-width: 640px;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-sm);
	}

	.hero-title {
		font-size: clamp(2.75rem, 2rem + 4.5vw, 5rem);
		letter-spacing: -0.02em;
		margin-bottom: var(--space-lg);
	}

	.hero-sub {
		font-size: var(--text-large);
		max-width: 520px;
		margin-bottom: var(--space-lg);
	}

	.hero-actions {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.hero-mark {
		flex-shrink: 0;
		width: 180px;
		height: 180px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-mark span {
		font-family: var(--font-heading);
		font-weight: var(--weight-light);
		font-size: 3rem;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	@media (max-width: 860px) {
		.hero-mark {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.hero-inner {
			padding-block: var(--space-2xl) var(--space-xl);
		}
	}

	/* Selected work — masonry */
	.work-section {
		padding-top: var(--space-3xl);
	}

	/* Base state is CSS multi-column — a reasonable immediate render for
	   no-JS visitors and before initMasonry() runs. Once JS measures real
	   image heights it re-parents items into .masonry-col flex columns
	   (shortest-column-first), which never leaves the gap that
	   column-count + break-inside:avoid can produce when a tall item gets
	   pushed to the next column early. */
	.masonry {
		margin-top: var(--space-xl);
		column-count: 3;
		column-gap: var(--space-md);
	}

	.masonry.masonry-js {
		display: flex;
		align-items: flex-start;
		gap: var(--space-md);
	}

	.masonry :global(.masonry-col) {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		flex: 1 1 0;
		min-width: 0;
	}

	.masonry-item {
		display: block;
		width: 100%;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.masonry:not(.masonry-js) .masonry-item {
		margin-bottom: var(--space-md);
		break-inside: avoid;
	}

	.masonry-item img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.15s ease;
	}

	.masonry-item:hover img {
		transform: scale(1.02);
	}

	@media (max-width: 720px) {
		.masonry:not(.masonry-js) {
			column-count: 2;
		}
	}

	@media (max-width: 480px) {
		.masonry:not(.masonry-js) {
			column-count: 1;
		}
	}

	.view-all {
		margin-top: var(--space-xl);
	}

	/* Career timeline — a vertical rail with a dot per era; type scale
	   steps up from earliest to most recent role so the hierarchy itself
	   tells the story of growth across the career, not just the copy. */
	.timeline {
		list-style: none;
		margin: var(--space-2xl) 0 0;
		padding: 0;
		position: relative;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 5px;
		top: 6px;
		bottom: 6px;
		width: 1px;
		background: var(--color-border);
	}

	.timeline-item {
		position: relative;
		padding-left: var(--space-xl);
		padding-bottom: var(--space-2xl);
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.timeline-dot {
		position: absolute;
		left: 0;
		top: 8px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 1px solid var(--color-text);
	}

	.timeline-item:last-child .timeline-dot {
		background: var(--color-text);
	}

	.timeline-content h3 {
		font-size: calc(var(--text-h4) + var(--i, 0) * 0.3rem);
		margin-bottom: var(--space-xs);
	}

	.timeline-role {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-transform: lowercase;
		margin-bottom: var(--space-sm);
	}

	.timeline-content p:last-child {
		max-width: 560px;
		margin-bottom: 0;
	}

	/* Testimonial */
	.testimonial-section {
		text-align: center;
	}

	.testimonial-track {
		margin: 0 auto;
		max-width: 760px;
	}

	.testimonial {
		margin: 0;
	}

	.testimonial p {
		font-size: var(--text-h3);
		font-weight: var(--weight-light);
		line-height: var(--line-height-tight);
		color: var(--color-text);
		margin-bottom: var(--space-md);
	}

	.testimonial cite {
		font-style: normal;
		font-size: var(--text-small);
		color: var(--color-text-secondary);
	}

	.testimonial-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-lg);
		margin-top: var(--space-lg);
	}

	.testimonial-arrow {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		cursor: pointer;
	}

	.testimonial-arrow:hover {
		background: var(--color-bg-subtle);
	}

	.testimonial-dots {
		display: flex;
		gap: var(--space-xs);
	}

	.testimonial-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: none;
		background: var(--color-border);
		padding: 0;
		cursor: pointer;
	}

	.testimonial-dot[aria-selected='true'] {
		background: var(--color-text);
	}

	/* Contact — two columns, last section before the footer */
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2xl);
		align-items: start;
	}

	.contact-details {
		margin-top: var(--space-lg);
		font-size: var(--text-large);
	}

	@media (max-width: 720px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
