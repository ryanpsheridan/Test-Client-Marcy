---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site,
};

const totalLabel = String(projects.length).padStart(2, '0');
---

<BaseLayout title="Home" description={SITE_DESCRIPTION} noFooter fullHeight>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!--
		The entire homepage: one project at a time, contained and centered
		(never full-bleed/full-screen), filling exactly one viewport with no
		page scroll — a single "screen" rather than a scrolling page. Career
		history and testimonials now live on /about/; the contact form lives
		on /contact/ — both were redundant repeated here.
	-->
	<section class="featured" id="featured">
		<div class="featured-stage">
			<button type="button" class="featured-image-link" id="featured-link">
				<img
					src={projects[0].heroImage.src}
					alt={projects[0].heroImage.alt}
					class="featured-image"
					id="featured-image"
				/>
			</button>
			<span class="cursor-label" id="cursor-label" aria-hidden="true">next</span>
		</div>

		<div class="container featured-controls">
			<button type="button" class="featured-control" id="featured-prev">prev</button>
			<p class="featured-count"><span id="featured-index">01</span> / {totalLabel}</p>
			<button type="button" class="featured-control" id="featured-next">next</button>
		</div>

		<div class="featured-filmstrip-wrap">
			<div class="featured-filmstrip" id="featured-filmstrip" role="tablist" aria-label="Select project">
				{projects.map((project, i) => (
					<button
						type="button"
						class="filmstrip-thumb"
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-label={project.title}
					>
						<img src={project.heroImage.src} alt="" loading="lazy" />
					</button>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const section = document.getElementById('featured');
	const link = document.getElementById('featured-link') as HTMLButtonElement | null;
	const image = document.getElementById('featured-image') as HTMLImageElement | null;
	const cursorLabel = document.getElementById('cursor-label');
	const indexLabel = document.getElementById('featured-index');
	const prevBtn = document.getElementById('featured-prev');
	const nextBtn = document.getElementById('featured-next');
	const filmstrip = document.getElementById('featured-filmstrip');

	if (section && link && image && cursorLabel && indexLabel && prevBtn && nextBtn && filmstrip) {
		const thumbs = Array.from(filmstrip.children) as HTMLButtonElement[];
		let current = 0;
		let timer: ReturnType<typeof setInterval> | null = null;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function show(i: number) {
			current = (i + thumbs.length) % thumbs.length;
			const thumb = thumbs[current];
			const thumbImg = thumb.querySelector('img') as HTMLImageElement;

			image!.src = thumbImg.src;
			image!.alt = thumb.getAttribute('aria-label') || '';
			indexLabel!.textContent = String(current + 1).padStart(2, '0');

			thumbs.forEach((t, n) => t.setAttribute('aria-selected', n === current ? 'true' : 'false'));
			thumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
		}

		function startAutoplay() {
			if (prefersReducedMotion) return;
			stopAutoplay();
			timer = setInterval(() => show(current + 1), 5000);
		}

		function stopAutoplay() {
			if (timer) clearInterval(timer);
			timer = null;
		}

		function goTo(i: number) {
			show(i);
			startAutoplay();
		}

		thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goTo(i)));
		prevBtn.addEventListener('click', () => goTo(current - 1));
		nextBtn.addEventListener('click', () => goTo(current + 1));

		// Left half of the image = prev, right half = next, with a small
		// label that follows the cursor to show which. Hover-only — mouse
		// devices get this; touch devices keep the explicit prev/next row
		// (mobile-only in CSS) since there's no hover to reveal the split.
		// A plain button (not <a href>) on purpose — an anchor here made
		// the browser's native link-preview status bar pop up over the
		// filmstrip on hover, which a page can't suppress via CSS since
		// browsers show it deliberately (so a link's real destination
		// can't be hidden). No href to hover means no status bar.
		const hasHover = window.matchMedia('(hover: hover)').matches;

		if (hasHover) {
			link.addEventListener('mousemove', (e) => {
				const rect = link!.getBoundingClientRect();
				const isNext = e.clientX - rect.left > rect.width / 2;
				cursorLabel!.textContent = isNext ? 'next' : 'prev';
				cursorLabel!.style.left = `${e.clientX}px`;
				cursorLabel!.style.top = `${e.clientY}px`;
			});

			link.addEventListener('mouseenter', () => cursorLabel!.classList.add('visible'));
			link.addEventListener('mouseleave', () => cursorLabel!.classList.remove('visible'));

			link.addEventListener('click', (e) => {
				const rect = link!.getBoundingClientRect();
				const isNext = e.clientX - rect.left > rect.width / 2;
				goTo(current + (isNext ? 1 : -1));
			});
		}

		document.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') goTo(current - 1);
			if (e.key === 'ArrowRight') goTo(current + 1);
		});

		// Pause on hover/focus so autoplay doesn't pull the image away
		// mid-look, and whenever the tab isn't visible.
		section.addEventListener('pointerenter', stopAutoplay);
		section.addEventListener('pointerleave', startAutoplay);
		section.addEventListener('focusin', stopAutoplay);
		section.addEventListener('focusout', startAutoplay);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stopAutoplay();
			else startAutoplay();
		});

		startAutoplay();
	}
</script>

<style>
	.featured {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
	}

	/* Bounded stage, not full-bleed — object-fit:contain within whatever
	   space is left after the caption/controls/filmstrip take theirs, so
	   a very tall or very wide project photo is never cropped, and — since
	   this space is fixed rather than sized by the image itself — swapping
	   between differently-shaped images never shifts the rest of the page. */
	/* .featured-image-link is a flex item here (not centered-and-shrunk),
	   so it actually receives a definite height from the flexbox layout —
	   percentage/max-height on a child otherwise only resolves against an
	   ancestor with a *definite* height, which align-items:center content
	   sizing does not provide, and the image overflowed past the caption
	   and controls below it as a result. */
	.featured-stage {
		flex: 1;
		min-height: 0;
		display: flex;
		padding: calc(var(--space-md) + 32px) var(--space-lg);
	}

	.featured-image-link {
		flex: 1;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.featured-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: var(--radius-md);
	}

	/* Follows the cursor over the image to show which half — left/prev,
	   right/next — a click will act on. Sits to the left of the cursor
	   (not centered on it) so the label itself is never hidden under the
	   pointer. Fixed positioning + JS-set left/top (viewport coordinates
	   from the mousemove event) rather than relative-to-image, so it
	   isn't clipped by the image's own bounding box near the edges. */
	.cursor-label {
		position: fixed;
		left: 0;
		top: 0;
		transform: translate(calc(-100% - 14px), -50%);
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-transform: lowercase;
		pointer-events: none;
		opacity: 0;
		z-index: 10;
		transition: opacity 0.1s ease;
	}

	.cursor-label.visible {
		opacity: 1;
	}

	/* Desktop relies on the filmstrip (thumbnails are a large enough
	   target with a mouse) plus autoplay; this row is mobile-only, where
	   filmstrip thumbs are small and autoplay is easier to want to stop. */
	.featured-controls {
		display: none;
	}

	@media (max-width: 640px) {
		.featured-controls {
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-xl);
			padding-block: var(--space-sm);
		}
	}

	.featured-control {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		text-transform: lowercase;
		color: var(--color-text-secondary);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.featured-control:hover {
		color: var(--color-text);
	}

	.featured-count {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		margin: 0;
		font-variant-numeric: tabular-nums;
	}

	/* Filmstrip — flush with the bottom of the viewport (the flex column
	   layout puts it last, and body.full-height has no page scroll, so it
	   naturally stays pinned there without needing position:sticky).
	   Thumbs are a fixed small size and the row is centered rather than
	   stretched to fill the width — leaves space on either side on wide
	   screens, but keeps the 4:3 crop honest instead of distorting width. */
	/* Flush with the very bottom of the viewport — env() only adds space
	   on notched/gesture-nav devices that actually need it for their
	   safe area; everywhere else this is 0, so no dead gap under the
	   strip. */
	.featured-filmstrip-wrap {
		flex-shrink: 0;
		padding-bottom: env(safe-area-inset-bottom);
	}

	.featured-filmstrip {
		display: flex;
		justify-content: center;
		gap: 3px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.featured-filmstrip::-webkit-scrollbar {
		display: none;
	}

	.filmstrip-thumb {
		flex: 0 0 auto;
		width: 64px;
		aspect-ratio: 4 / 3;
		padding: 0;
		border: 0;
		cursor: pointer;
		opacity: 0.5;
		filter: grayscale(1);
		transition: opacity 0.15s ease, filter 0.15s ease;
	}

	/* ~20% larger on mobile — a bigger tap target, since a mouse-precision
	   64px thumb is a little small to hit reliably with a finger. */
	@media (max-width: 640px) {
		.filmstrip-thumb {
			width: 77px;
		}
	}

	.filmstrip-thumb:hover,
	.filmstrip-thumb[aria-selected='true'] {
		opacity: 1;
		filter: grayscale(0);
	}

	.filmstrip-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
