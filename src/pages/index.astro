---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_EMAIL } from '../consts';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	jobTitle: 'Global Creative Director',
	description: SITE_DESCRIPTION,
	url: Astro.site,
	email: SITE_EMAIL,
};

const highlights = [
	{
		role: 'Global Creative Director',
		org: 'Wella Company',
		description: 'Shaping brand development, advertising, and consumer product strategy across the portfolio, drawing on deep expertise as a hair care specialist.',
	},
	{
		role: 'Leadership roles',
		org: 'Coty',
		description: 'Contributed to global brand development and creative strategy for major beauty brands.',
	},
	{
		role: 'Leadership roles',
		org: 'Procter & Gamble',
		description: 'Early career foundation in global brand development and creative strategy.',
	},
];

const galleryPreview = [
	{ src: '/images/gallery/placeholder-1.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-2.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-3.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-4.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-5.svg', alt: 'Replace with a real, descriptive alt text for this project' },
];
---

<BaseLayout title="Home" description={SITE_DESCRIPTION}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-content">
				<p class="eyebrow">global creative director</p>
				<h1 class="hero-title">marcy cona</h1>
				<p class="hero-sub">
					Shaping brand, advertising, and product strategy in beauty and consumer products
					&mdash; over two decades building work that balances innovation with accessibility.
				</p>
				<div class="hero-actions">
					<a href="/gallery/" class="btn btn-primary">view work</a>
					<a href="/contact/" class="btn btn-secondary">get in touch</a>
				</div>
				<p class="hero-meta">brand development &middot; advertising &middot; consumer products</p>
			</div>
			<div class="hero-mark" aria-hidden="true">
				<span>mc</span>
			</div>
		</div>
	</section>

	<section class="container section work-section">
		<h2>selected work</h2>
		<p class="section-intro">
			A look at recent work &mdash; visit the <a href="/gallery/">full gallery</a> for more.
		</p>
		<div class="masonry">
			{galleryPreview.map((image) => (
				<a href="/gallery/" class="masonry-item">
					<img src={image.src} alt={image.alt} loading="lazy" />
				</a>
			))}
		</div>
	</section>

	<section class="container section">
		<h2>about</h2>
		<p class="bio">
			With over four years as Global Creative Director at Wella Company, I specialize in
			brand development, advertising, and consumer products, leveraging deep expertise as a
			hair expert to shape impactful campaigns and narratives. My role focuses on driving
			the creative direction of products by balancing innovation and accessibility to meet
			diverse consumer needs.
		</p>
		<p class="bio">
			My career spans over two decades, including leadership roles at Coty and Procter &amp;
			Gamble, where I contributed to global brand development and creative strategies.
			Passionate about merging science, strategy, and imagination, I strive to build brands
			that redefine beauty and inspire creative commerce.
		</p>
	</section>

	<section class="band band-subtle">
		<div class="container section">
			<h2>experience</h2>
			<ul class="highlight-grid">
				{highlights.map((item) => (
					<li class="highlight-card">
						<h3>{item.org}</h3>
						<p class="highlight-role">{item.role}</p>
						<p>{item.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="band band-subtle">
		<div class="container section contact-section">
			<div class="contact-grid">
				<div class="contact-info">
					<h2>get in touch</h2>
					<p>
						Open to conversations about creative direction, brand strategy, and new
						opportunities.
					</p>
					<p class="contact-details">
						<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
					</p>
				</div>
				<div class="contact-form-wrap">
					<ContactForm />
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Full-width background bands — the band itself spans the viewport,
	   while a nested .container keeps the actual content at the same max
	   width as every other section instead of the background looking like
	   a floating inset card. */
	.band-subtle {
		background: var(--color-bg-subtle);
	}

	.section {
		padding-block: var(--space-2xl);
	}

	.section-intro {
		max-width: 640px;
	}

	.bio {
		max-width: 640px;
	}

	/* Hero */
	.hero {
		border-bottom: 1px solid var(--color-border);
	}

	.hero-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2xl);
		padding-block: var(--space-3xl) var(--space-2xl);
	}

	.hero-content {
		max-width: 640px;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-sm);
	}

	.hero-title {
		font-size: clamp(2.75rem, 2rem + 4.5vw, 5rem);
		letter-spacing: -0.02em;
		margin-bottom: var(--space-lg);
	}

	.hero-sub {
		font-size: var(--text-large);
		max-width: 520px;
		margin-bottom: var(--space-lg);
	}

	.hero-actions {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
		margin-bottom: var(--space-lg);
	}

	.hero-meta {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		text-transform: lowercase;
		margin: 0;
	}

	.hero-mark {
		flex-shrink: 0;
		width: 180px;
		height: 180px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-mark span {
		font-family: var(--font-heading);
		font-weight: var(--weight-light);
		font-size: 3rem;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	@media (max-width: 860px) {
		.hero-mark {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.hero-inner {
			padding-block: var(--space-2xl) var(--space-xl);
		}
	}

	/* Selected work — masonry */
	.work-section {
		padding-top: var(--space-3xl);
	}

	.masonry {
		margin-top: var(--space-xl);
		column-count: 3;
		column-gap: var(--space-md);
	}

	.masonry-item {
		display: block;
		width: 100%;
		margin-bottom: var(--space-md);
		break-inside: avoid;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.masonry-item img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 0.15s ease;
	}

	.masonry-item:hover img {
		transform: scale(1.02);
	}

	@media (max-width: 720px) {
		.masonry {
			column-count: 2;
		}
	}

	@media (max-width: 480px) {
		.masonry {
			column-count: 1;
		}
	}

	/* Experience */
	.highlight-grid {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-lg);
	}

	.highlight-card {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-lg);
		background: var(--color-bg);
	}

	.highlight-card h3 {
		font-size: var(--text-h4);
		margin-bottom: var(--space-xs);
	}

	.highlight-role {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.highlight-card p:last-child {
		margin-bottom: 0;
	}

	/* Contact — two columns, last section before the footer */
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2xl);
		align-items: start;
	}

	.contact-details {
		margin-top: var(--space-lg);
		font-size: var(--text-large);
	}

	@media (max-width: 720px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
