---
import BaseLayout from '../layouts/BaseLayout.astro';

// Real images live in public/images/gallery/ — see CLAUDE.md's "Gallery /
// Photo Uploads" section for the naming convention. Every photo opens in a
// shared lightbox dialog on click.
const images = [
	{ src: '/images/gallery/placeholder-1.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-2.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-3.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-4.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-5.svg', alt: 'Replace with a real, descriptive alt text for this project' },
	{ src: '/images/gallery/placeholder-6.svg', alt: 'Replace with a real, descriptive alt text for this project' },
];
---

<BaseLayout title="Gallery" description="Selected creative direction and brand work from Marcy Cona.">
	<section class="container section">
		<h1>gallery</h1>
		<p class="lead">
			Selected campaigns, brand work, and creative direction &mdash; replace this copy and
			every photo below with the real thing.
		</p>
	</section>

	<section class="container section">
		<ul class="photo-grid">
			{images.map((image) => (
				<li>
					<button type="button" class="gallery-trigger grid-item" data-src={image.src} data-alt={image.alt}>
						<img src={image.src} alt={image.alt} loading="lazy" />
					</button>
				</li>
			))}
		</ul>
	</section>

	<dialog id="lightbox" class="lightbox" aria-label="Photo preview">
		<button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">&times;</button>
		<img id="lightbox-img" src="" alt="" />
	</dialog>
</BaseLayout>

<script>
	const dialog = document.getElementById('lightbox') as HTMLDialogElement;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

	let lastTrigger: HTMLElement | null = null;

	function openLightbox(trigger: HTMLElement) {
		const img = trigger.querySelector('img');
		const src = trigger.dataset.src || img?.src || '';
		const alt = trigger.dataset.alt || img?.alt || '';
		if (!src) return;
		lastTrigger = trigger;
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		dialog.showModal();
	}

	dialog.addEventListener('close', () => {
		lastTrigger?.focus();
	});

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;

		if (target.closest('#lightbox-close')) {
			dialog.close();
			return;
		}

		if (target === dialog) {
			dialog.close();
			return;
		}

		const trigger = target.closest<HTMLElement>('.gallery-trigger');
		if (trigger) {
			openLightbox(trigger);
		}
	});
</script>

<style>
	.section {
		padding-block: var(--space-2xl);
	}

	.lead {
		font-size: var(--text-large);
		color: var(--color-text-secondary);
		max-width: 640px;
	}

	/* Plain button reset so every clickable photo stays keyboard-focusable
	   and announced correctly, with none of the default button chrome. */
	.gallery-trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.photo-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
	}

	.grid-item img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--color-bg-subtle);
		transition: transform 0.15s ease;
	}

	.grid-item:hover img {
		transform: scale(1.02);
	}

	@media (max-width: 720px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.photo-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Lightbox — visual/positioning rules only apply while [open], so a
	   closed <dialog> keeps the UA default display:none instead of
	   sitting invisibly on top of the page and eating clicks. */
	.lightbox {
		margin: 0;
		padding: var(--space-xl);
		border: none;
		background: transparent;
	}

	@media (max-width: 640px) {
		.lightbox {
			padding: var(--space-md);
		}
	}

	.lightbox[open] {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox::backdrop {
		background: rgba(20, 20, 20, 0.9);
	}

	.lightbox img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: var(--radius-md);
	}

	.lightbox-close {
		position: absolute;
		top: var(--space-lg);
		right: var(--space-lg);
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.92);
		color: var(--color-text);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		-webkit-tap-highlight-color: transparent;
	}

	@media (max-width: 640px) {
		.lightbox-close {
			top: var(--space-sm);
			right: var(--space-sm);
		}
	}

	.lightbox-close:hover {
		background: var(--color-bg);
	}
</style>
