---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_EMAIL } from '../consts';

const focusAreas = ['brand development', 'advertising', 'consumer products', 'packaging', 'creative strategy'];
---

<BaseLayout
	title="Contact"
	description="Get in touch with Marcy Cona about creative direction, brand strategy, or new opportunities."
>
	<section class="container section contact-grid">
		<div class="contact-copy">
			<h1>contact</h1>
			<p class="lead">
				Open to conversations about creative direction, brand strategy, and new opportunities.
			</p>
			<p>
				<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
			</p>

			<img
				src="/images/gallery/behind-the-scenes.jpg"
				alt="Marcy Cona on set with the production team, reviewing hair styling and color during a shoot"
				class="contact-photo"
			/>

			<div class="form-wrap">
				<ContactForm />
			</div>
		</div>

		<aside class="contact-side">
			<ul class="chip-row">
				{focusAreas.map((area) => (
					<li class="chip">{area}</li>
				))}
			</ul>
		</aside>
	</section>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-2xl);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 240px;
		gap: var(--space-3xl);
		align-items: start;
	}

	.contact-copy {
		max-width: 560px;
	}

	.lead {
		font-size: var(--text-large);
	}

	.contact-photo {
		width: 100%;
		border-radius: var(--radius-lg);
		margin-top: var(--space-xl);
	}

	.form-wrap {
		margin-top: var(--space-xl);
	}

	.contact-side {
		position: sticky;
		top: var(--space-xl);
	}

	.chip-row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.chip {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: var(--space-xs) var(--space-md);
		text-transform: lowercase;
		text-align: center;
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.contact-side {
			position: static;
		}

		.chip-row {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.chip {
			text-align: left;
		}
	}
</style>
