---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_EMAIL } from '../consts';
---

<BaseLayout
	title="Contact"
	description="Get in touch with Marcy Cona about creative direction, brand strategy, or new opportunities."
>
	<section class="container section">
		<h1>contact</h1>
		<p class="lead">
			Open to conversations about creative direction, brand strategy, and new opportunities.
		</p>
		<p>
			<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
		</p>

		<div class="form-wrap">
			<ContactForm />
		</div>
	</section>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-2xl);
		max-width: 560px;
	}

	.lead {
		font-size: var(--text-large);
	}

	.form-wrap {
		margin-top: var(--space-xl);
	}
</style>
