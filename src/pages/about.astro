---
import BaseLayout from '../layouts/BaseLayout.astro';

const focusAreas = ['brand development', 'advertising', 'consumer products', 'packaging', 'creative strategy'];

// Most recent first, like LinkedIn's own experience list.
const career = [
	{
		org: 'Wella Company',
		role: 'Global Creative Director',
		year: '2020–2024',
		description: 'Shaping brand development, advertising, and consumer product strategy across the portfolio, drawing on deep expertise as a hair care specialist.',
	},
	{
		org: 'Coty',
		role: 'Global Creative Director',
		year: '2016–2020',
		description: 'Continued leading global creative direction and brand development for major beauty brands.',
	},
	{
		org: 'Procter & Gamble',
		role: 'Global Creative Director',
		year: '2003–2016',
		description: 'Thirteen years leading global creative direction, brand development, and creative strategy.',
	},
];

const testimonials = [
	{
		quote: 'I’ve had the pleasure to work with Marcy over several years, during our time together at P&G, and then at Wella. I could not recommend Marcy enough as an outstanding expert in all aspects of Beauty Production — and in particular for Hair.',
		name: 'Javier Sandoval',
	},
	{
		quote: 'I have worked with Marcy in the last 4 years in Wella. She has always been a great team member and colleague, extremely dedicated, results driven and willing to share her expertise.',
		name: 'Sara Traversi',
	},
	{
		quote: 'Marcy’s expertise was crucial during the retouching and design phases, where she oversaw every detail related to hair color, texture, and styling. She ensured that all the models’ hair looked perfect for each shot.',
		name: 'Edward Luttrell',
	},
];
---

<BaseLayout
	title="About"
	description="About Marcy Cona — two decades of creative direction, brand development, and advertising work for Wella, Clairol, Coty, and Procter & Gamble."
>
	<section class="container section about-grid">
		<aside class="about-side">
			<ul class="chip-row">
				{focusAreas.map((area) => (
					<li class="chip">{area}</li>
				))}
			</ul>
		</aside>

		<div class="about-copy">
			<p class="eyebrow">about</p>
			<h1>marcy cona</h1>
			<p class="bio lead">
				A creative director with two decades of experience shaping brand, advertising, and
				product work in beauty and consumer goods &mdash; Global Creative Director at Wella
				Company from 2020 to 2024, and at Coty from 2016 to 2020, following thirteen years in
				the same role at Procter &amp; Gamble.
			</p>
			<p class="bio">
				Across that career, the throughline has been the same: brand development, advertising,
				and consumer products, with deep expertise as a hair care specialist shaping campaigns
				and narratives that balance innovation with accessibility &mdash; driving creative
				direction that meets people where they actually are, not just where a brief says they
				should be.
			</p>
			<p class="bio">
				Passionate about merging science, strategy, and imagination, the work throughout has
				aimed to build brands that redefine beauty and inspire creative commerce. This site is a
				look back at a selection of that work.
			</p>

			<img
				src="/images/gallery/behind-the-scenes.jpg"
				alt="Marcy Cona on set with the production team, reviewing hair styling and color during a shoot"
				class="about-photo"
			/>

			<div class="about-actions">
				<a href="/portfolio/" class="btn btn-primary">view the work</a>
				<a href="/contact/" class="btn btn-secondary">get in touch</a>
			</div>
		</div>
	</section>

	<section class="band band-subtle">
		<div class="container section">
			<h2>career</h2>
			<ol class="timeline">
				{career.map((item) => (
					<li class="timeline-item">
						<span class="timeline-dot" aria-hidden="true"></span>
						<div class="timeline-content">
							<h3>{item.org}</h3>
							<p class="timeline-role">{item.role} &middot; {item.year}</p>
							<p>{item.description}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="testimonial-section">
		<button type="button" class="testimonial-click" id="testimonial-click" aria-label="Show next quote">
			<div class="testimonial-track" id="testimonial-track">
				{testimonials.map((t, i) => (
					<blockquote class:list={['testimonial', { active: i === 0 }]} aria-hidden={i !== 0}>
						<p>&ldquo;{t.quote}&rdquo;</p>
						<footer>
							<cite>{t.name}</cite>
						</footer>
					</blockquote>
				))}
			</div>
		</button>
		<span class="cursor-label" id="testimonial-cursor-label" aria-hidden="true">next</span>
	</section>
</BaseLayout>

<script>
	const wrap = document.getElementById('testimonial-click') as HTMLButtonElement | null;
	const track = document.getElementById('testimonial-track') as HTMLDivElement | null;
	const cursorLabel = document.getElementById('testimonial-cursor-label');

	if (wrap && track && cursorLabel) {
		const slides = Array.from(track.children) as HTMLElement[];

		if (slides.length > 1) {
			let index = 0;

			function show(i: number) {
				index = (i + slides.length) % slides.length;
				slides.forEach((slide, n) => {
					slide.classList.toggle('active', n === index);
					slide.setAttribute('aria-hidden', n === index ? 'false' : 'true');
				});
			}

			function zoneFor(e: MouseEvent): 'prev' | 'next' {
				const rect = wrap!.getBoundingClientRect();
				return e.clientX - rect.left > rect.width / 2 ? 'next' : 'prev';
			}

			wrap.addEventListener('click', (e) => {
				show(zoneFor(e) === 'next' ? index + 1 : index - 1);
			});

			const hasHover = window.matchMedia('(hover: hover)').matches;
			if (hasHover) {
				wrap.addEventListener('mousemove', (e) => {
					cursorLabel!.textContent = zoneFor(e);
					cursorLabel!.style.left = `${e.clientX}px`;
					cursorLabel!.style.top = `${e.clientY}px`;
				});
				wrap.addEventListener('mouseenter', () => cursorLabel!.classList.add('visible'));
				wrap.addEventListener('mouseleave', () => cursorLabel!.classList.remove('visible'));
			}

			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') show(index - 1);
				if (e.key === 'ArrowRight') show(index + 1);
			});
		} else {
			wrap.style.cursor = 'default';
		}
	}
</script>

<style>
	.section {
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	.band-subtle {
		background: var(--color-bg-subtle);
	}

	/* Chips pinned to a narrow left rail, content column centered in the
	   remaining space — an editorial layout (text column with generous
	   margins) rather than the copy simply filling whatever's left. */
	.about-grid {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--space-3xl);
		align-items: start;
	}

	.about-copy {
		max-width: 640px;
		margin-inline: auto;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-sm);
	}

	.bio {
		max-width: 640px;
	}

	.lead {
		font-size: var(--text-large);
		color: var(--color-text);
	}

	.chip-row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.chip {
		font-size: var(--text-small);
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: var(--space-xs) var(--space-md);
		text-transform: lowercase;
		text-align: center;
	}

	.about-actions {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
		margin-top: var(--space-xl);
	}

	.about-side {
		position: sticky;
		top: var(--space-xl);
	}

	.about-photo {
		display: block;
		width: 100%;
		max-width: 420px;
		margin: var(--space-xl) auto;
		border-radius: var(--radius-lg);
	}

	@media (max-width: 860px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about-side {
			position: static;
		}

		.chip-row {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
		}

		.chip {
			flex: 0 0 auto;
		}
	}

	/* Career timeline — a vertical rail with a dot per era; type scale
	   steps up from earliest to most recent role so the hierarchy itself
	   tells the story of growth across the career, not just the copy. */
	.timeline {
		list-style: none;
		margin: var(--space-xl) 0 0;
		padding: 0;
		position: relative;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 5px;
		top: 6px;
		bottom: 6px;
		width: 1px;
		background: var(--color-border);
	}

	.timeline-item {
		position: relative;
		padding-left: var(--space-xl);
		padding-bottom: var(--space-2xl);
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	/* Same treatment for every era, deliberately — a filled/highlighted
	   dot on the most recent role read as "currently works here," which
	   isn't the case. */
	.timeline-dot {
		position: absolute;
		left: 0;
		top: 8px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 1px solid var(--color-text);
	}

	.timeline-content h3 {
		font-size: var(--text-h4);
		margin-bottom: var(--space-xs);
	}

	.timeline-role {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-transform: lowercase;
		margin-bottom: var(--space-sm);
	}

	.timeline-content p:last-child {
		max-width: 560px;
		margin-bottom: 0;
	}

	/* Testimonial — generous min-height with everything centered inside it
	   (not just top-padded), so a single short quote still reads as a
	   deliberate, breathing moment rather than a cramped box. */
	.testimonial-section {
		position: relative;
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: var(--space-3xl);
	}

	.testimonial-click {
		display: block;
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		text-align: center;
	}

	/* All slides stacked in the same grid cell (not display:none'd via
	   [hidden]) so the track's height is always the tallest quote, not
	   whichever one happens to be active — swapping slides never changes
	   the section's height, which was shifting the whole page below it. */
	.testimonial-track {
		display: grid;
	}

	.testimonial {
		grid-column: 1;
		grid-row: 1;
		margin: 0;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.testimonial.active {
		opacity: 1;
	}

	.testimonial p {
		font-size: var(--text-h3);
		font-weight: var(--weight-light);
		line-height: var(--line-height-tight);
		color: var(--color-text);
		margin-bottom: var(--space-md);
	}

	.testimonial cite {
		font-style: normal;
		font-size: var(--text-small);
		color: var(--color-text-secondary);
	}

	/* Same cursor-following prev/next hint as the homepage viewer —
	   left half of the quote is prev, right half is next. No visible
	   arrows/dots; hover-only (touch devices just tap left/right). */
	.cursor-label {
		position: fixed;
		left: 0;
		top: 0;
		transform: translate(calc(-100% - 14px), -50%);
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		text-transform: lowercase;
		pointer-events: none;
		opacity: 0;
		z-index: 10;
		transition: opacity 0.1s ease;
	}

	.cursor-label.visible {
		opacity: 1;
	}
</style>
